# Database: the uploaded export was generated by phpMyAdmin, so MySQL is the default.
DATABASE_URL=mysql+pymysql://readonly_user:readonly_password@127.0.0.1:3306/s_demo
SQL_DIALECT=mysql

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval / generation
CHROMA_PATH=./chroma_db
ADMIN_SCHEMAS_PATH=./admin/admin_schemas
TOP_TABLES=3
TOP_COLUMNS=14
TOP_EXAMPLES=4
SQL_CANDIDATES=3
MAX_REPAIR_ATTEMPTS=2
DEFAULT_ROW_LIMIT=20
MAX_ROW_LIMIT=20
DB_TIMEOUT_SECONDS=8
ENABLE_DATA_SAMPLING=true
RETURN_DEBUG=true
# Optional: stable signed browser sessions; use a long random value.
SESSION_SECRET=

# Deterministic value/entity resolution across policy-approved database columns
ENABLE_ENTITY_RESOLUTION=true
ENTITY_RESOLUTION_COLUMNS_LIMIT=300
ENTITY_RESOLUTION_MATCHES_PER_COLUMN=4

# Optional IANA timezone for interpreting relative dates (for example Asia/Karachi).
BUSINESS_TIMEZONE=
